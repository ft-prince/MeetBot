# noteAI / MeetMaster — production env for meet.nexren.ai
# Copy to deploy/.env and fill in. Never commit deploy/.env.

# ── Infra ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                 # long random string: openssl rand -hex 24
CLOUDFLARE_TUNNEL_TOKEN=           # Cloudflare Zero Trust → Networks → Tunnels → (tunnel) → token
SESSION_SECRET=                    # long random string: openssl rand -hex 32

# ── Public URL ───────────────────────────────────────────────────────────────
APP_BASE_URL=https://meet.nexren.ai
GOOGLE_REDIRECT_URI=https://meet.nexren.ai/accounts/google/login/callback/

# ── Google OAuth (user login, Calendar, Gmail) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Speech-to-text (Deepgram) ────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=hi               # hi = Hindi + English code-switching; multi = auto

# ── AI summaries ─────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Email (summaries, reminders, bot-logged-out alerts) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prince.saiyad@nexren.ai
SMTP_PASS=                         # 16-letter Google App Password
SMTP_FROM=prince.saiyad@nexren.ai
SUPPORT_EMAIL=prince.saiyad@nexren.ai

# ── Meeting bots ─────────────────────────────────────────────────────────────
BOT_HEADLESS=true
ZOOM_BOT_MODE=inhouse
TEAMS_BOT_MODE=inhouse
# BOT_MAX_DURATION_MIN=180         # stuck-bot health check interval
# BOT_ALONE_EXIT_MIN=10            # leave after being alone this long

# ── Optional: Recall.ai fallback (only if ZOOM/TEAMS_BOT_MODE=recall) ────────
# RECALL_API_KEY=
# RECALL_WEBHOOK_SECRET=
