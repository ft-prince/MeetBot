PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/noteai
WHISPER_URL=ws://localhost:3002

# --- Speech-to-text engine ---
# STT_ENGINE selects the transcription backend:
#   deepgram — Deepgram nova-2 streaming (default, cloud)
#   whisper  — local WhisperX sidecar  (python whisper_service.py, :3002)
#   aikosh   — local AIKosh/AI4Bharat IndicConformer (python aikosh_service.py, :3003)
STT_ENGINE=deepgram
# WebSocket URL of the AIKosh sidecar (used when STT_ENGINE=aikosh)
AIKOSH_STT_URL=ws://localhost:3003

# Deepgram (STT_ENGINE=deepgram)
DEEPGRAM_API_KEY=
# Optional: force a language (default 'multi' = auto EN/ES). e.g. hi, zh, fr
DEEPGRAM_LANGUAGE=multi

# AIKosh / AI4Bharat IndicConformer (STT_ENGINE=aikosh)
# Gated model — accept the license + set a HuggingFace read token:
HF_TOKEN=
# Indic language code (hi, ta, te, bn, mr, ...) and decoding (ctc=fast, rnnt=accurate)
AIKOSH_LANG=hi
AIKOSH_DECODING=ctc

# Zoom bot engine: 'inhouse' (Playwright ZoomBot, default) or 'recall' (Recall AI fallback)
ZOOM_BOT_MODE=inhouse
# In-house Zoom bot — run `npx tsx scripts/zoom-login.ts` once to create the profile
BOT_ZOOM_CHROME_PROFILE_DIR=
ZOOM_BOT_MODE=inhouse
# Recall AI fallback — only used when ZOOM_BOT_MODE=recall
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
RECALL_BASE_URL=https://ap-northeast-1.recall.ai/api/v1

# --- Bot engine ---
# Master capture engine:
#   inhouse  — in-process Playwright bots (default)
#   vexa     — self-hosted Vexa bot API, no browser automation
#   docker   — spin up a noteai-bot Docker container per meeting
BOT_ENGINE=inhouse

# --- Docker engine (BOT_ENGINE=docker) ---
# Build the image first: docker build -t noteai-bot -f bot-service/Dockerfile .
BOT_DOCKER_IMAGE=noteai-bot
# Linux: host  |  macOS: bridge (needs host-gateway alias)
BOT_DOCKER_NETWORK=host
# Backend WebSocket base URL reachable from INSIDE the container
# Linux (--network=host):  ws://localhost:8001
# macOS Docker Desktop:    ws://host.docker.internal:8001
BOT_DOCKER_BACKEND_WS=ws://localhost:8001
# Optional extra `docker run` flags, e.g. --cpus=1 --memory=1g
BOT_DOCKER_EXTRA_FLAGS=

# --- Vexa (self-hosted, open-source bot API) ---
# Self-hosted gateway from `make all` (default :8056). Hosted: https://api.cloud.vexa.ai
VEXA_API_URL=http://localhost:8056
VEXA_API_KEY=
VEXA_BOT_NAME=NoteAI
# Empty = auto-detect language. Otherwise an ISO code e.g. en, es, hi
VEXA_LANGUAGE=
